<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Clinic - Gestão para Clínicas</title>
<style>
:root {
  --primary: #0EA5E9;
  --primary-dark: #0284C7;
  --primary-light: #E0F2FE;
  --secondary: #10B981;
  --accent: #8B5CF6;
  --danger: #EF4444;
  --warning: #F59E0B;
  --dark: #0F172A;
  --dark2: #1E293B;
  --gray-50: #F8FAFC;
  --gray-100: #F1F5F9;
  --gray-200: #E2E8F0;
  --gray-300: #CBD5E1;
  --gray-400: #94A3B8;
  --gray-500: #64748B;
  --gray-700: #334155;
  --gray-900: #0F172A;
  --sidebar-w: 260px;
  --header-h: 64px;
  --radius: 14px;
  --shadow: 0 1px 3px rgba(0,0,0,0.07), 0 4px 16px rgba(0,0,0,0.05);
  --shadow-md: 0 4px 6px rgba(0,0,0,0.07), 0 10px 30px rgba(0,0,0,0.08);
  --shadow-lg: 0 10px 15px rgba(0,0,0,0.1), 0 20px 40px rgba(0,0,0,0.1);
}
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Segoe UI',system-ui,sans-serif;background:#F0F6FF;color:var(--gray-900);display:flex;min-height:100vh;overflow-x:hidden;}

/* ========== SIDEBAR ========== */
.sidebar{
  width:var(--sidebar-w);background:var(--dark);
  position:fixed;top:0;left:0;bottom:0;
  display:flex;flex-direction:column;z-index:200;
  transition:width .3s ease;overflow:hidden;
}
.sidebar.mini{width:70px;}
.sb-logo{
  padding:18px 20px;display:flex;align-items:center;gap:12px;
  border-bottom:1px solid rgba(255,255,255,.07);min-height:var(--header-h);
}
.sb-logo-icon{
  width:36px;height:36px;min-width:36px;
  background:linear-gradient(135deg,var(--primary),var(--accent));
  border-radius:10px;display:flex;align-items:center;justify-content:center;
  font-size:18px;
}
.sb-logo-text{white-space:nowrap;overflow:hidden;}
.sb-logo-text h2{color:#fff;font-size:16px;font-weight:800;letter-spacing:-.3px;}
.sb-logo-text span{color:var(--primary);font-size:10px;font-weight:600;letter-spacing:1px;text-transform:uppercase;}
.sidebar.mini .sb-logo-text{display:none;}

.sb-nav{flex:1;padding:14px 10px;overflow-y:auto;overflow-x:hidden;}
.sb-nav::-webkit-scrollbar{width:4px;}
.sb-nav::-webkit-scrollbar-thumb{background:rgba(255,255,255,.1);border-radius:4px;}
.nav-label{
  font-size:9px;font-weight:700;color:var(--gray-500);
  text-transform:uppercase;letter-spacing:1.5px;
  padding:3px 10px 6px;margin-top:8px;white-space:nowrap;
}
.sidebar.mini .nav-label{visibility:hidden;}
.nav-item{
  display:flex;align-items:center;gap:12px;
  padding:10px 12px;border-radius:10px;
  color:rgba(255,255,255,.55);font-size:13.5px;font-weight:500;
  cursor:pointer;transition:all .2s;margin-bottom:2px;white-space:nowrap;
  position:relative;
}
.nav-item:hover{background:rgba(255,255,255,.07);color:rgba(255,255,255,.9);}
.nav-item.active{background:var(--primary);color:#fff;}
.nav-item .ni{font-size:17px;min-width:22px;text-align:center;}
.nav-item .nt{flex:1;}
.nav-item .nb{
  background:var(--danger);color:#fff;font-size:9px;font-weight:700;
  padding:2px 6px;border-radius:20px;min-width:18px;text-align:center;
}
.sidebar.mini .nt,.sidebar.mini .nb{display:none;}
.sidebar.mini .nav-item{justify-content:center;}

.sb-footer{padding:14px 10px;border-top:1px solid rgba(255,255,255,.07);}
.sb-user{
  display:flex;align-items:center;gap:10px;
  padding:10px;border-radius:10px;cursor:pointer;
  transition:all .2s;
}
.sb-user:hover{background:rgba(255,255,255,.07);}
.sb-avatar{
  width:34px;height:34px;min-width:34px;border-radius:50%;
  background:linear-gradient(135deg,var(--primary),var(--accent));
  display:flex;align-items:center;justify-content:center;
  font-size:13px;font-weight:700;color:#fff;
}
.sb-user-info{overflow:hidden;}
.sb-user-info p{color:#fff;font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.sb-user-info span{color:var(--gray-500);font-size:11px;}
.sidebar.mini .sb-user-info{display:none;}

/* ========== MAIN ========== */
.main{margin-left:var(--sidebar-w);flex:1;display:flex;flex-direction:column;transition:margin-left .3s ease;min-width:0;}
.main.wide{margin-left:70px;}

/* ========== HEADER ========== */
.header{
  background:#fff;height:var(--header-h);
  display:flex;align-items:center;justify-content:space-between;
  padding:0 24px;position:sticky;top:0;z-index:100;
  box-shadow:0 1px 0 var(--gray-200);
}
.hdr-left{display:flex;align-items:center;gap:14px;}
.toggle-btn{
  width:36px;height:36px;border:none;background:var(--gray-100);
  border-radius:9px;cursor:pointer;font-size:15px;
  display:flex;align-items:center;justify-content:center;
  transition:all .2s;
}
.toggle-btn:hover{background:var(--primary-light);color:var(--primary);}
.page-title{font-size:17px;font-weight:700;}
.page-sub{font-size:11px;color:var(--gray-400);}
.hdr-right{display:flex;align-items:center;gap:10px;}
.search-box{
  display:flex;align-items:center;gap:8px;
  background:var(--gray-100);border-radius:10px;padding:8px 14px;width:230px;
}
.search-box input{border:none;background:none;outline:none;font-size:13px;width:100%;}
.hdr-btn{
  width:38px;height:38px;border:none;background:var(--gray-100);
  border-radius:10px;cursor:pointer;font-size:16px;
  display:flex;align-items:center;justify-content:center;
  transition:all .2s;position:relative;
}
.hdr-btn:hover{background:var(--primary-light);color:var(--primary);}
.hdr-dot{position:absolute;top:8px;right:8px;width:8px;height:8px;background:var(--danger);border-radius:50%;border:2px solid #fff;}
.btn{
  display:inline-flex;align-items:center;gap:6px;
  padding:9px 18px;border-radius:10px;font-size:13px;font-weight:600;
  cursor:pointer;border:none;transition:all .2s;
}
.btn-primary{background:var(--primary);color:#fff;}
.btn-primary:hover{background:var(--primary-dark);transform:translateY(-1px);box-shadow:0 4px 12px rgba(14,165,233,.35);}
.btn-success{background:var(--secondary);color:#fff;}
.btn-success:hover{background:#059669;transform:translateY(-1px);}
.btn-outline{background:#fff;color:var(--gray-700);border:1.5px solid var(--gray-200);}
.btn-outline:hover{border-color:var(--primary);color:var(--primary);background:var(--primary-light);}
.btn-sm{padding:6px 12px;font-size:12px;border-radius:8px;}
.btn-danger{background:var(--danger);color:#fff;}
.btn-danger:hover{background:#DC2626;}

/* ========== CONTENT ========== */
.content{flex:1;padding:24px;overflow-y:auto;}
.page{display:none;animation:fadeIn .3s ease;}
.page.active{display:block;}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}

/* ========== CARDS ========== */
.card{background:#fff;border-radius:var(--radius);box-shadow:var(--shadow);padding:22px;}
.card-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;}
.card-title{font-size:14px;font-weight:700;}
.card-sub{font-size:11px;color:var(--gray-400);margin-top:2px;}

/* ========== STAT CARDS ========== */
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px;margin-bottom:22px;}
.stat-card{
  background:#fff;border-radius:var(--radius);padding:20px;
  box-shadow:var(--shadow);cursor:pointer;transition:all .25s;
  position:relative;overflow:hidden;
}
.stat-card::after{
  content:'';position:absolute;bottom:-20px;right:-20px;
  width:80px;height:80px;border-radius:50%;opacity:.07;
}
.stat-card.blue::after{background:var(--primary);}
.stat-card.green::after{background:var(--secondary);}
.stat-card.purple::after{background:var(--accent);}
.stat-card.orange::after{background:var(--warning);}
.stat-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-md);}
.sc-top{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:14px;}
.sc-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;}
.sc-icon.blue{background:#E0F2FE;color:var(--primary);}
.sc-icon.green{background:#D1FAE5;color:var(--secondary);}
.sc-icon.purple{background:#EDE9FE;color:var(--accent);}
.sc-icon.orange{background:#FEF3C7;color:var(--warning);}
.sc-trend{font-size:11px;font-weight:600;padding:3px 8px;border-radius:20px;}
.sc-trend.up{background:#D1FAE5;color:#059669;}
.sc-trend.down{background:#FEE2E2;color:#DC2626;}
.sc-val{font-size:28px;font-weight:800;letter-spacing:-1px;color:var(--gray-900);}
.sc-label{font-size:12px;color:var(--gray-400);font-weight:500;margin-top:3px;}

/* ========== GRIDS ========== */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;}
.g31{display:grid;grid-template-columns:2fr 1fr;gap:20px;margin-bottom:20px;}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;margin-bottom:20px;}
.g13{display:grid;grid-template-columns:1fr 2fr;gap:20px;margin-bottom:20px;}

/* ========== CHART ========== */
.chart-bars{display:flex;align-items:flex-end;gap:8px;height:160px;padding-bottom:0;}
.cbar-wrap{display:flex;flex-direction:column;align-items:center;gap:4px;flex:1;}
.cbar-inner{display:flex;gap:3px;align-items:flex-end;width:100%;}
.cbar{
  flex:1;border-radius:6px 6px 0 0;
  transition:opacity .2s;cursor:pointer;min-width:8px;
}
.cbar:hover{opacity:.75;}
.cbar.a{background:var(--primary);}
.cbar.b{background:#BAE6FD;}
.cbar-label{font-size:10px;color:var(--gray-400);text-align:center;}
.chart-legend{display:flex;gap:16px;margin-top:14px;}
.cl-item{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--gray-500);}
.cl-dot{width:10px;height:10px;border-radius:3px;}

/* ========== DONUT ========== */
.donut-wrap{display:flex;align-items:center;gap:20px;}
.donut-svg{width:120px;height:120px;min-width:120px;}
.donut-legend{flex:1;}
.dl-item{display:flex;align-items:center;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--gray-100);}
.dl-item:last-child{border-bottom:none;}
.dl-left{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--gray-600);}
.dl-dot{width:10px;height:10px;border-radius:3px;}
.dl-val{font-size:13px;font-weight:700;color:var(--gray-900);}

/* ========== TABLE ========== */
.tbl-wrap{overflow-x:auto;}
table{width:100%;border-collapse:collapse;}
thead th{
  padding:10px 14px;text-align:left;
  font-size:10px;font-weight:700;color:var(--gray-400);
  text-transform:uppercase;letter-spacing:.8px;
  background:var(--gray-50);border-bottom:1px solid var(--gray-100);
}
thead th:first-child{border-radius:8px 0 0 8px;}
thead th:last-child{border-radius:0 8px 8px 0;}
tbody td{padding:13px 14px;font-size:13px;color:var(--gray-700);border-bottom:1px solid var(--gray-50);}
tbody tr:last-child td{border-bottom:none;}
tbody tr{transition:background .15s;cursor:pointer;}
tbody tr:hover{background:var(--gray-50);}
.p-cell{display:flex;align-items:center;gap:10px;}
.p-avatar{
  width:32px;height:32px;border-radius:9px;
  display:flex;align-items:center;justify-content:center;
  font-size:11px;font-weight:700;color:#fff;min-width:32px;
}
.p-name{font-weight:600;font-size:13px;color:var(--gray-900);}
.p-info{font-size:11px;color:var(--gray-400);}

/* ========== BADGE ========== */
.badge{display:inline-block;font-size:10px;font-weight:700;padding:3px 9px;border-radius:20px;}
.badge-success{background:#D1FAE5;color:#059669;}
.badge-warning{background:#FEF3C7;color:#D97706;}
.badge-danger{background:#FEE2E2;color:#DC2626;}
.badge-info{background:#DBEAFE;color:#2563EB;}
.badge-gray{background:var(--gray-100);color:var(--gray-500);}
.badge-purple{background:#EDE9FE;color:#7C3AED;}
.badge-cyan{background:#CFFAFE;color:#0891B2;}

/* ========== AGENDA / CALENDAR ========== */
.agenda-grid{display:grid;grid-template-columns:300px 1fr;gap:20px;margin-bottom:20px;}
.mini-cal{background:#fff;border-radius:var(--radius);padding:20px;box-shadow:var(--shadow);}
.cal-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;}
.cal-nav{width:28px;height:28px;border:none;background:var(--gray-100);border-radius:8px;cursor:pointer;font-size:12px;display:flex;align-items:center;justify-content:center;transition:all .2s;}
.cal-nav:hover{background:var(--primary-light);color:var(--primary);}
.cal-month{font-size:14px;font-weight:700;}
.cal-days-header{display:grid;grid-template-columns:repeat(7,1fr);text-align:center;margin-bottom:8px;}
.cal-days-header span{font-size:10px;font-weight:700;color:var(--gray-400);padding:4px;}
.cal-days{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;}
.cal-day{
  aspect-ratio:1;display:flex;align-items:center;justify-content:center;
  font-size:12px;border-radius:8px;cursor:pointer;transition:all .2s;
  color:var(--gray-700);font-weight:500;position:relative;
}
.cal-day:hover{background:var(--gray-100);}
.cal-day.other{color:var(--gray-300);}
.cal-day.today{background:var(--primary);color:#fff;font-weight:700;}
.cal-day.has-apt::after{
  content:'';position:absolute;bottom:3px;left:50%;transform:translateX(-50%);
  width:4px;height:4px;background:var(--secondary);border-radius:50%;
}
.cal-day.today.has-apt::after{background:#fff;}
.cal-day.selected{background:var(--primary-light);color:var(--primary);font-weight:700;}

.appointments-list{background:#fff;border-radius:var(--radius);padding:20px;box-shadow:var(--shadow);}
.apt-item{
  display:flex;align-items:center;gap:14px;padding:14px;
  border-radius:10px;margin-bottom:8px;transition:all .2s;cursor:pointer;
  border:1px solid var(--gray-100);
}
.apt-item:last-child{margin-bottom:0;}
.apt-item:hover{border-color:var(--primary-light);background:var(--primary-light);}
.apt-time{
  text-align:center;min-width:52px;background:var(--gray-50);
  border-radius:8px;padding:8px 6px;
}
.apt-hour{font-size:15px;font-weight:800;color:var(--primary);}
.apt-ampm{font-size:9px;color:var(--gray-400);font-weight:600;}
.apt-color{width:4px;height:44px;border-radius:4px;min-width:4px;}
.apt-info{flex:1;}
.apt-patient{font-size:14px;font-weight:600;color:var(--gray-900);}
.apt-type{font-size:12px;color:var(--gray-400);margin-top:2px;}
.apt-doctor{display:flex;align-items:center;gap:6px;margin-top:4px;font-size:11px;color:var(--gray-500);}
.apt-right{display:flex;flex-direction:column;align-items:flex-end;gap:6px;}

/* ========== PATIENTS ========== */
.patients-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:16px;margin-bottom:20px;}
.pat-card{
  background:#fff;border-radius:var(--radius);padding:18px;
  box-shadow:var(--shadow);transition:all .25s;cursor:pointer;
  border-top:3px solid transparent;
}
.pat-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-md);}
.pat-card.cardio{border-color:#EF4444;}
.pat-card.ortho{border-color:#8B5CF6;}
.pat-card.general{border-color:#0EA5E9;}
.pat-card.derma{border-color:#F59E0B;}
.pat-card.neuro{border-color:#10B981;}
.pc-head{display:flex;align-items:center;gap:12px;margin-bottom:14px;}
.pc-avatar{width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:700;color:#fff;min-width:46px;}
.pc-name{font-size:15px;font-weight:700;color:var(--gray-900);}
.pc-id{font-size:11px;color:var(--gray-400);}
.pc-info{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px;}
.pc-info-item{background:var(--gray-50);border-radius:8px;padding:8px 10px;}
.pc-info-label{font-size:9px;font-weight:700;color:var(--gray-400);text-transform:uppercase;letter-spacing:.5px;}
.pc-info-val{font-size:13px;font-weight:600;color:var(--gray-900);margin-top:2px;}
.pc-footer{display:flex;justify-content:space-between;align-items:center;}
.pc-last{font-size:11px;color:var(--gray-400);}

/* ========== FINANCIAL ========== */
.fin-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:20px;}
.fin-card{background:#fff;border-radius:var(--radius);padding:18px;box-shadow:var(--shadow);text-align:center;}
.fin-icon{font-size:28px;margin-bottom:8px;}
.fin-label{font-size:11px;color:var(--gray-400);font-weight:600;margin-bottom:6px;}
.fin-amount{font-size:22px;font-weight:800;letter-spacing:-0.5px;}
.fin-amount.green{color:var(--secondary);}
.fin-amount.red{color:var(--danger);}
.fin-amount.blue{color:var(--primary);}
.fin-amount.purple{color:var(--accent);}
.fin-sub{font-size:10px;color:var(--gray-400);margin-top:3px;}

/* ========== MEDICAL RECORDS ========== */
.rec-list{display:flex;flex-direction:column;gap:14px;}
.rec-item{
  background:#fff;border-radius:var(--radius);padding:18px;
  box-shadow:var(--shadow);display:flex;align-items:flex-start;gap:16px;
  transition:all .2s;cursor:pointer;
}
.rec-item:hover{box-shadow:var(--shadow-md);transform:translateX(4px);}
.rec-icon{
  width:42px;height:42px;border-radius:12px;min-width:42px;
  display:flex;align-items:center;justify-content:center;font-size:18px;
}
.rec-info{flex:1;}
.rec-patient{font-size:14px;font-weight:700;color:var(--gray-900);}
.rec-desc{font-size:12px;color:var(--gray-500);margin-top:3px;line-height:1.5;}
.rec-meta{display:flex;align-items:center;gap:14px;margin-top:8px;}
.rec-meta span{font-size:11px;color:var(--gray-400);display:flex;align-items:center;gap:4px;}
.rec-right{display:flex;flex-direction:column;align-items:flex-end;gap:8px;}

/* ========== ACTIVITY ========== */
.act-list{display:flex;flex-direction:column;}
.act-item{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid var(--gray-100);}
.act-item:last-child{border-bottom:none;}
.act-icon{width:34px;height:34px;min-width:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:14px;}
.act-body{flex:1;}
.act-text{font-size:13px;color:var(--gray-700);}
.act-text b{color:var(--gray-900);}
.act-time{font-size:11px;color:var(--gray-400);margin-top:3px;}

/* ========== QUICK STATS ========== */
.qs-item{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--gray-100);}
.qs-item:last-child{border-bottom:none;}
.qs-left{display:flex;align-items:center;gap:10px;}
.qs-icon{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:14px;}
.qs-label{font-size:13px;font-weight:500;color:var(--gray-700);}
.qs-val{font-size:14px;font-weight:700;color:var(--gray-900);}
.qs-bar-wrap{margin-top:6px;}
.prog-wrap{height:5px;background:var(--gray-100);border-radius:10px;overflow:hidden;margin-top:4px;}
.prog-fill{height:100%;border-radius:10px;transition:width 1s ease;}

/* ========== MODAL ========== */
.modal-overlay{
  position:fixed;inset:0;background:rgba(15,23,42,.5);
  z-index:500;display:flex;align-items:center;justify-content:center;
  opacity:0;pointer-events:none;transition:opacity .25s;
  backdrop-filter:blur(4px);
}
.modal-overlay.open{opacity:1;pointer-events:all;}
.modal{
  background:#fff;border-radius:var(--radius);padding:28px;
  width:520px;max-width:95vw;max-height:90vh;overflow-y:auto;
  transform:scale(.95) translateY(10px);transition:all .25s;
  box-shadow:var(--shadow-lg);
}
.modal-overlay.open .modal{transform:scale(1) translateY(0);}
.modal-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px;}
.modal-title{font-size:17px;font-weight:700;}
.modal-close{
  width:30px;height:30px;border:none;background:
